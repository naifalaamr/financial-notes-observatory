---
import '../styles/global.css';
import '../styles/obs.css';
import Mark from '../components/Mark.astro';
import { withBase } from '../lib/obs';
interface Props { title?: string; description?: string; nav?: 'report' | 'orgs' | 'patterns' | 'framework' | 'method' | null; kicker?: string; lede?: string }
const { title, description = 'التقرير التجميعي لملاحظات وتوصيات تحليل القوائم المالية للمنظمات غير الربحية — الدفعة 47.', nav = null, lede = '', kicker = 'مرصد الملاحظات المالية' } = Astro.props;
const full = title ? `${title} · مرصد الملاحظات المالية` : 'مرصد الملاحظات المالية · الدفعة 47';
const links = [
  ['report', '', 'التقرير التجميعي', 'التقرير'],
  ['orgs', 'orgs/', 'ملخصات المنظمات', 'المنظمات'],
  ['patterns', 'patterns/', 'أنماط الملاحظات', 'الأنماط'],
  ['framework', 'framework/', 'إطار التقييم', 'الإطار'],
  ['method', 'method/', 'المنهجية', 'المنهجية'],
] as const;
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="format-detection" content="telephone=no, date=no, address=no" />
  <meta name="theme-color" content="#F4F6FA" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0F1424" media="(prefers-color-scheme: dark)" />
  <meta name="robots" content="noindex" />
  <title>{full}</title>
  <meta name="description" content={description} />
  <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500&display=swap" />
  <script is:inline>document.documentElement.classList.add('js');try{var t=localStorage.getItem('dg_theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch(e){}</script>

<meta property="og:title" content="مرصد الملاحظات المالية · الدفعة 47" />
<meta property="og:description" content="التقرير التجميعي لملاحظات وتوصيات تحليل القوائم المالية للمنظمات غير الربحية." />
<meta property="og:type" content="website" />
<meta property="og:locale" content="ar_SA" />
<meta property="og:site_name" content="مرصد الملاحظات المالية" />
<meta property="og:url" content="https://naifalaamr.github.io/financial-notes-observatory/" />
<meta property="og:image" content="https://naifalaamr.github.io/financial-notes-observatory/og.png?v=2" />
<meta property="og:image:secure_url" content="https://naifalaamr.github.io/financial-notes-observatory/og.png?v=2" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="شعار مرصد الملاحظات المالية · الدفعة 47" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="مرصد الملاحظات المالية · الدفعة 47" />
<meta name="twitter:description" content="التقرير التجميعي لملاحظات وتوصيات تحليل القوائم المالية للمنظمات غير الربحية." />
<meta name="twitter:image" content="https://naifalaamr.github.io/financial-notes-observatory/og.png?v=2" />
<meta name="twitter:image:alt" content="شعار مرصد الملاحظات المالية" />
<link rel="canonical" href="https://naifalaamr.github.io/financial-notes-observatory/" />
</head>
<body>
  <a class="skip" href="#main">تخطَّ إلى المحتوى</a>
  <div class="idbar">
    <div class="wrap">
      <a class="mark" href={withBase('')} aria-label="مرصد الملاحظات المالية — الرئيسية">
        <Mark />
        <span class="w"><b>مرصد الملاحظات المالية</b><span>الدفعة 47 · جامعة الباحة</span></span>
      </a>
      <div class="end">
        <span class="meta">مقرر تنمية الموارد المالية · بإشراف د. علي بن سليمان الفوزان</span>
        <button class="theme-btn" type="button" id="themeBtn" aria-label="المظهر: تلقائي" title="المظهر: تلقائي"><svg class="i-auto" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"></circle><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"></path></svg><svg class="i-light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg><svg class="i-dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg></button>
      </div>
    </div>
    <div class="stripe" aria-hidden="true"><span></span><span></span><span></span></div>
  </div>
  <header class="top">
    <div class="wrap">
      <slot name="hero">
        <div class="brand">
          {kicker && <p style="margin:0 0 2px;font-size:13px">{kicker}</p>}
          <h1>{title}</h1>
          {lede && <p class="lede">{lede}</p>}
        </div>
      </slot>
      <nav class="nav" aria-label="أقسام المرصد">
        {links.map(([k, href, label, short]) => <a href={withBase(href)} aria-current={nav === k ? 'page' : undefined} aria-label={label}><span class="full">{label}</span><span class="short" aria-hidden="true">{short}</span></a>)}
      </nav>
    </div>
  </header>
  <main id="main" class="wrap"><slot /></main>
  <footer><div class="wrap">مرصد الملاحظات المالية · الدفعة 47 · ماجستير إدارة الأوقاف والمنظمات غير الربحية — جامعة الباحة · إعداد التقرير التجميعي: عمر سالم العتيبي، نايف سعيد الزهراني، سعيد عبدالله عسيري، نايف عوض الغامدي، عزة سعيد الزهراني، مها سليم القثامي، نايفة مسفر الغامدي · الإصدار النهائي المعتمد 1.0 (3 نوفمبر 2026) · المحتوى مستخلص من ملخصات الزملاء بمساعدة الذكاء الاصطناعي</div></footer>
  <script>
    // الأقسام القابلة للطي: افتح القسم الذي يشير إليه الرابط
    const openTarget = (id: string) => { const el = id && document.getElementById(id); if (el instanceof HTMLDetailsElement) el.open = true; };
    openTarget(decodeURIComponent(location.hash.slice(1)));
    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest('a[href^="#"]') as HTMLAnchorElement | null;
      if (a) openTarget(decodeURIComponent(a.hash.slice(1)));
    });
    const btn = document.getElementById('themeBtn')!;
    const label = { auto: 'تلقائي', light: 'فاتح', dark: 'داكن' } as const;
    let mode = (document.documentElement.dataset.theme as 'light' | 'dark' | undefined) ?? 'auto';
    const paint = () => { const t = 'المظهر: ' + label[mode]; btn.setAttribute('aria-label', t); btn.title = t; btn.dataset.mode = mode; };
    paint();
    btn.addEventListener('click', () => {
      mode = mode === 'auto' ? 'light' : mode === 'light' ? 'dark' : 'auto';
      if (mode === 'auto') delete document.documentElement.dataset.theme; else document.documentElement.dataset.theme = mode;
      try { mode === 'auto' ? localStorage.removeItem('dg_theme') : localStorage.setItem('dg_theme', mode); } catch {}
      paint();
    });
  </script>
</body>
</html>
