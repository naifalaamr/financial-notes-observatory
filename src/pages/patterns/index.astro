---
import Base from '../../layouts/Base.astro';
import { CATS, CAT_COLOR, PRI, patternStats, tierOf, TIER, TIER_SHORT, withBase, ENTITIES, pct } from '../../lib/obs';
const pats = patternStats().filter((p) => p.n > 0);
const groups = CATS.map((c) => ({ ...c, list: pats.filter((p) => p.cat === c.code) })).filter((g) => g.list.length)
  .sort((a, b) => b.list.reduce((s, p) => s + p.n, 0) - a.list.reduce((s, p) => s + p.n, 0));
---
<Base nav="patterns" title="أنماط الملاحظات">
  <div class="brand home" slot="hero">
    <p style="margin:0 0 2px;font-size:13px">التصنيف الموحد</p>
    <h1>أنماط الملاحظات</h1>
    <p class="hstats"><span><b class="num">{pats.length}</b> نمطاً</span><span><b class="num">{CATS.length}</b> محاور</span><span class="minor">الرقم الكبير = عدد المنظمات التي ظهر فيها النمط من {ENTITIES.size}</span></p>
  </div>
  <div style="padding:22px 0 64px">
    {groups.map((g) => (
      <section style={`margin-bottom:26px;--cc:var(${CAT_COLOR[g.code]})`}>
        <h2 style="font-size:19px;margin-bottom:10px">{g.name}</h2>
        <div class="pgrid">
          {g.list.map((p) => (
            <a class="pcard" href={withBase(`patterns/${p.code}/`)}>
              <h3>{p.name}</h3>
              <div class="k"><span><b>{p.orgs}</b> منظمة ({pct(p.orgs, ENTITIES.size)}%)</span><span><b>{p.n}</b> ملاحظة</span>{p.crit > 0 && <span><b>{p.crit}</b> جوهرية</span>}</div>
              <div class="row1" style="display:flex;gap:6px;flex-wrap:wrap"><span class={`pri ${p.pri}`}>{PRI[p.pri]}</span><span class="chip" title={TIER[tierOf(p.orgs)]}>{TIER_SHORT[tierOf(p.orgs)]}</span></div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>
