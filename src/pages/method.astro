---
import Base from '../layouts/Base.astro';
import { ANALYSES, CATS, PATTERNS, NOTES, SEV, SEV_ORDER, sevCounts, withBase, idOf, codeOf, ENTITIES } from '../lib/obs';
const s = sevCounts(NOTES);
const flags = [
  ...ANALYSES.filter((a) => a.partial).map((a) => [a, a.partial] as const),
  ...ANALYSES.filter((a) => a.scheme).map((a) => [a, a.scheme] as const),
];
---
<Base nav="method" title="المنهجية وحدود البيانات">
  <div class="report" style="grid-template-columns:minmax(0,1fr)">
    <div>
      <section class="rsec">
        <h2><span class="n">1</span> مصادر البيانات</h2>
        <p>52 ملفاً رُفعت عبر نموذج التسليم: 43 PDF و7 Word وملف Pages وصورة. بعد استبعاد المكرر بقي 48 تحليلاً عن <b>{ENTITIES.size} منظمة</b>، دُمجت في <b>{ANALYSES.length} ملخصاً</b>، ملخص واحد لكل منظمة:</p>
        <ul>
          <li>ملفان مرفوعان مرتين بالمحتوى نفسه  فاحتُسب كل منهما مرة واحدة.</li>
          <li>زميلة رفعت ملخصاً وعرضاً تفصيلياً للمنظمة نفسها، فاعتُمد الملخص.</li>
          <li>ثلاث منظمات حللها أكثر من زميل (إحداها ثلاث مرات واثنتان مرتين)، فدُمجت تحليلات كل منها في ملخص واحد. الملاحظة التي رصدها أكثر من زميل (19 حالة) بقيت مرة واحدة بالخطورة الأعلى والصياغة الأكثر تفصيلاً، وما انفرد به كل زميل بقي كما هو. الأرقام والدرجة في الملخص المدمج من التحليل الأشمل، ومقارنة التحليلات قبل الدمج في القسم 7 من التقرير.</li>
        </ul>
      </section>
      <section class="rsec">
        <h2><span class="n">2</span> خطوات العمل</h2>
        <ol>
          <li><b>التحويل إلى نص:</b> استُخرج نص ملفات PDF وWord آلياً، وقُرئت الصورة والملف الممسوح ضوئياً بصرياً صفحةً صفحة.</li>
          <li><b>الاستخراج:</b> سُجلت كل ملاحظة في سجل موحد يضم: المنظمة، ونص الملاحظة مختصراً بأرقامه، وخطورتها كما حددها المعدّ، والتوصية المرتبطة بها. واستُخرجت المؤشرات الرئيسية (الدرجة، الإيرادات، المصروفات، النتيجة، النقد، نسبة البرامج).</li>
          <li><b>التصنيف:</b> وُزعت الملاحظات على 9 محاور موضوعية، ثم جُمعت المتشابهة منها في {PATTERNS.length - 1} نمطاً بقواعد كلمات مفتاحية ثم مراجعة يدوية للحالات الملتبسة.</li>
          <li><b>العدّ:</b> لكل نمط عدد الملاحظات وعدد المنظمات وعدد الجوهرية. وصُنفت الأنماط إلى مشتركة (15 منظمة فأكثر) ومتكررة (8–14) وخاصة (أقل من 8).</li>
          <li><b>المطابقة مع إطار التقييم:</b> رُبط كل نمط بمؤشرات الأداء المالي الخمسة ومعامل رأي المراجع، وبالأسئلة التحليلية الـ33، وبالمؤشرات المساندة لدليل 2026، وفق تعريفات مراجع أداة د. علي الفوزان (<a href={withBase('framework/')}>صفحة إطار التقييم</a>).</li>
          <li><b>التوصيات العامة:</b> صيغت توصية عامة لكل نمط مستندة إلى توصيات المعدّين، مع أولوية زمنية.</li>
        </ol>
        <p class="note">أُنجز الاستخراج والتصنيف بمساعدة الذكاء الاصطناعي، ويلزم مراجعة فريق العمل لعينة من الملاحظات مقابل ملفاتها الأصلية قبل اعتماد الأعداد. كل ملاحظة تحمل رقماً (مثل f08.3) يحيل إلى ملفها وترتيبها فيه.</p>
      </section>
      <section class="rsec">
        <h2><span class="n">3</span> الخطورة</h2>
        <p>اعتُمدت الخطورة كما حددها كل معدّ، ووُحدت المسميات (حرجة = جوهرية). الملاحظات التي لم يصنفها معدّها بقيت «غير مصنفة» ولم يُجتهد في تصنيفها.</p>
        <p>{SEV_ORDER.map((k) => <span class={`sev ${k}`} style="margin-inline-end:6px">{SEV[k].label}: {s[k]}</span>)}</p>
      </section>
      <section class="rsec">
        <h2><span class="n">4</span> المحاور والأنماط</h2>
        <div class="tablewrap"><table class="rt">
          <thead><tr><th>المحور</th><th>الأنماط</th></tr></thead>
          <tbody>{CATS.map((c) => <tr><td style="white-space:nowrap"><b>{c.name}</b></td><td>{PATTERNS.filter((p) => p.cat === c.code).map((p, i) => <>{i ? ' · ' : ''}<a href={withBase(`patterns/${p.code}/`)}>{p.name}</a></>)}</td></tr>)}</tbody>
        </table></div>
      </section>
      <section class="rsec">
        <h2><span class="n">5</span> ملفات تحتاج متابعة</h2>
        <ul class="notes">{flags.map(([a, f]) => <li><span class="chip mono">{codeOf(a)}</span><div><a href={withBase(`orgs/${idOf(a)}/`)}>{a.org}</a><div class="r">{f}</div></div></li>)}</ul>
      </section>
      <section class="rsec">
        <h2><span class="n">6</span> حدود القراءة</h2>
        <ul>
          <li>تختلف الملخصات في طولها وتفصيلها (من 5 ملاحظات إلى أكثر من 30)، فكثرة الملاحظات قد تعكس عمق التحليل لا ضعف المنظمة.</li>
          <li>درجة مؤشر الأداء المالي محسوبة من كل معدّ بطريقته، وقد نبّه د. علي الفوزان في المحاضرات إلى أن الدرجة التي تحسبها أداة التحليل ليست دقيقة؛ فتُعرض في المرصد كما وردت للاطلاع فقط، ولا تصلح للمقارنة أو الترتيب بين المنظمات.</li>
          <li>حُجبت أسماء الجمعيات وأرقام تسجيلها ومدنها ومسميات مشروعاتها وأوقافها، وتُعرض كل منظمة برقم ملفها ومجالها ومنطقتها الإدارية فقط. ولا يتضمن المرصد أسماء معدّي التحليلات ولا أرقامهم الجامعية.</li>
        </ul>
      </section>
      <section class="rsec">
        <h2><span class="n">7</span> فريق إعداد التقرير التجميعي</h2>
        <p>بتكليف من د. علي بن سليمان الفوزان، أعدّ التقرير التجميعي فريق من الدفعة 47:</p>
        <ul>
          <li>عمر سالم العتيبي — منسق الفريق</li>
          <li>نايف سعيد الزهراني</li>
          <li>سعيد عبدالله عسيري</li>
          <li>نايف عوض الغامدي</li>
          <li>عزة سعيد الزهراني</li>
          <li>مها سليم القثامي</li>
          <li>نايفة مسفر الغامدي</li>
        </ul>
        <p class="note">أسماء معدّي الملخصات الفردية لا تظهر في المرصد.</p>
      </section>
    </div>
  </div>
</Base>
