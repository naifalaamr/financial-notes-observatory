---
import Base from '../layouts/Base.astro';
import { scope, CAT_SHORT, ANALYSES, NOTES, CATS, CAT, CAT_COLOR, SEV, SEV_ORDER, PRI, PAT, ENTITIES, patternStats, tierOf, TIER, sevCounts, withBase, idOf, fmt, pct, byFile, notesOf } from '../lib/obs';

const nA = ANALYSES.length;
const nE = ENTITIES.size;
const nN = NOTES.length;
const issues = NOTES.filter((n) => n.sev !== 'p');
const sev = sevCounts(NOTES);
const pats = patternStats().filter((p) => p.n > 0);
const nP = pats.length;
const common = pats.filter((p) => tierOf(p.orgs) === 'common');
const recurring = pats.filter((p) => tierOf(p.orgs) === 'recurring');
const specific = pats.filter((p) => tierOf(p.orgs) === 'specific');
const topShare = pct(pats.slice(0, 10).reduce((s, p) => s + p.n, 0), issues.length);

// by category
const catRows = CATS.map((c) => {
  const list = issues.filter((n) => n.cat === c.code);
  const orgs = new Set(list.map((n) => n.e)).size;
  return { ...c, n: list.length, orgs, s: sevCounts(list) };
}).sort((a, b) => b.n - a.n);
const maxCat = Math.max(...catRows.map((c) => c.n));
const orgsWith = (cat: string) => new Set(issues.filter((n) => n.cat === cat).map((n) => n.e)).size;

// scores
const scored = ANALYSES.filter((a) => typeof a.m.score === 'number');
const avgScore = scored.reduce((s, a) => s + (a.m.score as number), 0) / scored.length;
const high = scored.filter((a) => (a.m.score as number) >= 90);
const highCrit = high.filter((a) => notesOf(a.file).some((n) => n.sev === 'c'));
const highLiq = high.filter((a) => notesOf(a.file).some((n) => n.pat === 'L1' || n.pat === 'S1' || n.pat === 'R3'));
const outShare = pct(issues.filter((n) => scope(n.pat) === 'out').length, issues.length);
const inShare = pct(issues.filter((n) => scope(n.pat) === 'in').length, issues.length);
const facShare = 100 - outShare - inShare;
const perA = Math.round(nN / nA);
const unclassified = pct(sev.u, nN);

// same organisation, different analysts
const dupes = [
  { label: 'المنظمة الأولى: حللها زميلان', files: ['f08', 'f27'] },
  { label: 'المنظمة الثانية: حللها ثلاثة زملاء', files: ['f05', 'f13', 'f14'] },
  { label: 'المنظمة الثالثة: حللها زميلان', files: ['f34', 'f40'] },
];
// stand-out specific findings
const standouts = ['f51.0', 'f01.0', 'f33.0', 'f23.0', 'f49.0', 'f25.0', 'f02.0', 'f40.25'].map((id) => NOTES.find((n) => n.id === id)!).filter(Boolean);

// heat: analyses × categories
const heat = ANALYSES.map((a) => {
  const l = notesOf(a.file).filter((n) => n.sev !== 'p');
  return { a, cells: CATS.map((c) => l.filter((n) => n.cat === c.code).length), tot: l.length };
}).sort((x, y) => y.tot - x.tot);
const heatMax = Math.max(...heat.flatMap((h) => h.cells));

// recommendations by priority (patterns seen in ≥5 organisations)
const recGroups = (['u', 'y', 'm'] as const).map((k) => ({ k, label: PRI[k], list: pats.filter((p) => p.pri === k && p.orgs >= 5) }));
const toc = [
  ['intro', 'مقدمة: الهدف والنطاق والمنهجية'],
  ['overview', 'الصورة الإجمالية'],
  ['repeat', 'الملاحظات المتكررة'],
  ['trends', 'أبرز الأنماط والاتجاهات'],
  ['tiers', 'المشترك والخاص'],
  ['recs', 'التوصيات العامة والأولويات'],
  ['quality', 'ملاحظة على جودة التحليلات'],
  ['map', 'خريطة الملاحظات'],
];
---
<Base nav="report" title="التقرير التجميعي">
  <div class="brand home" slot="hero">
    <h1 class="hero-claim">التقرير التجميعي للملاحظات المالية</h1>
    <p class="report-summary">نصف ما رصده المحللون لا تلتقطه درجة الأداء المالي</p>
    <p class="hstats">
      <span><b class="num">{nN}</b> ملاحظة</span>
      <span><b class="num">{nE}</b> منظمة</span>
      <span><b class="num">{nA}</b> تحليلاً</span>
      <span><b class="num">{nP}</b> نمطاً متكرراً</span>
      <span class="minor"><b class="num">{sev.c}</b> ملاحظة جوهرية</span>
    </p>
  </div>

  <div class="report">
    <div>
      <section class="rsec" id="intro">
        <h2><span class="n">1</span> مقدمة: الهدف والنطاق والمنهجية</h2>
        <p><b>الهدف:</b> جمع الملاحظات الواردة في تحليلات القوائم المالية التي أعدّها زملاء الدفعة 47 في ملف واحد، وتصنيفها، وقياس تكرارها بين المنظمات، واستخلاص التوصيات العامة وأولوياتها على مستوى المنظمات محل التحليل.</p>
        <p><b>النطاق:</b> {nA} تحليلاً مستقلاً عن {nE} منظمة أهلية (حللت ثلاث منظمات أكثر من مرة)، أغلبها عن السنتين الماليتين 2024م و2025م، ومصدرها الملخصات التنفيذية المرفوعة عبر نموذج التسليم.</p>
        <p><b>المنهجية باختصار:</b> حُوّلت الملفات كلها إلى نص (وقُرئت الصور والملفات الممسوحة بصرياً)، واستُخرجت كل ملاحظة بخطورتها وتوصيتها كما وردت لدى معدّها، ثم صُنّفت في 9 محاور موضوعية و{nP} نمطاً، وعُدّ تكرار كل نمط بعدد الملاحظات وعدد المنظمات. التفاصيل وحدود البيانات في <a href={withBase('method/')}>صفحة المنهجية</a>.</p>
      </section>

      <section class="rsec" id="overview">
        <h2><span class="n">2</span> الصورة الإجمالية</h2>
        <div class="split" role="img" aria-label={`${inShare}% تمس المؤشرات الخمسة، ${facShare}% تمس رأي المراجع، ${outShare}% خارج معادلة الدرجة`}>
      <a href={withBase('framework/')} class="seg in" style={`flex:${inShare}`}><b>{inShare}%</b><span>تمس المؤشرات الخمسة</span></a>
      <a href={withBase('framework/')} class="seg fac" style={`flex:${facShare}`}><b>{facShare}%</b><span>رأي المراجع</span></a>
      <a href={withBase('framework/')} class="seg out" style={`flex:${outShare}`}><b>{outShare}%</b><span>خارج معادلة الدرجة</span></a>
    </div>
        <div class="tiles">
          <div class="tilebox"><div class="big">{nN}</div><div class="lbl">إجمالي الملاحظات (منها {sev.p} إيجابية)</div></div>
          <div class="tilebox"><div class="big">{sev.c}</div><div class="lbl">ملاحظة جوهرية ({pct(sev.c, issues.length)}% من الملاحظات السلبية)</div></div>
          <div class="tilebox"><div class="big">{perA}</div><div class="lbl">ملاحظة في المتوسط لكل تحليل</div></div>
          <div class="tilebox"><div class="big">{fmt(Math.round(avgScore * 10) / 10)}</div><div class="lbl">متوسط درجة مؤشر الأداء المالي ({scored.length} تحليلاً ذكر الدرجة)</div></div>
        </div>
        <h3>توزيع الملاحظات على المحاور وخطورتها</h3>
        <div class="legend">{SEV_ORDER.filter((k) => k !== 'p').map((k) => <span><i class={k} style={`background:var(${k === 'c' ? '--bad' : k === 'm' ? '--warn' : k === 'l' ? '--t-gov' : '--line'})`}></i>{SEV[k].label}</span>)}</div>
        <div class="hbars">
          {catRows.map((c) => (
            <div class="hbar">
              <span>{c.name} <span class="note">· {c.orgs} منظمة</span></span>
              <span class="track" style={`width:${(c.n / maxCat) * 100}%`} title={`${c.n} ملاحظة`}>
                {(['c', 'm', 'l', 'u'] as const).map((k) => c.s[k] ? <span class={k} style={`width:${(c.s[k] / c.n) * 100}%`}></span> : null)}
              </span>
              <span class="v">{c.n}</span>
            </div>
          ))}
        </div>
        <p class="note">الخطورة كما حددها معدّ كل تحليل. {unclassified}% من الملاحظات وردت دون تصنيف خطورة لأن بعض الملخصات لم تصنّفها، فبقيت «غير مصنّفة» ولم يُجتهد في تصنيفها.</p>
      </section>

      <section class="rsec" id="repeat">
        <h2><span class="n">3</span> الملاحظات المتكررة</h2>
        <p>العمود الأهم هو <b>عدد المنظمات</b>: يبين في كم منظمة ظهر النمط، ولا يتأثر بتكراره داخل المنظمة الواحدة. تشكل الأنماط العشرة الأولى {topShare}% من الملاحظات السلبية كلها.</p>
        <div class="tablewrap">
          <table class="rt">
            <thead><tr><th>#</th><th>النمط</th><th>المحور</th><th class="num">المنظمات</th><th class="num">النسبة</th><th class="num">الملاحظات</th><th class="num">جوهرية</th></tr></thead>
            <tbody>
              {pats.slice(0, 20).map((p, i) => (
                <tr>
                  <td class="num">{i + 1}</td>
                  <td><a href={withBase(`patterns/${p.code}/`)}>{p.name}</a></td>
                  <td style="white-space:nowrap;color:var(--muted)">{CAT[p.cat]}</td>
                  <td class="num"><b>{p.orgs}</b></td>
                  <td class="num">{pct(p.orgs, nE)}%</td>
                  <td class="num">{p.n}</td>
                  <td class="num">{p.crit || '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="note">الأنماط الكاملة ({nP}) في <a href={withBase('patterns/')}>صفحة الأنماط</a>، ولكل نمط صفحة تسرد ملاحظاته ومنظماته.</p>
      </section>

      <section class="rsec" id="trends">
        <h2><span class="n">4</span> أبرز الأنماط والاتجاهات</h2>
        <div class="insight"><b>1. الأموال المقيدة هي أكثر ما يتكرر خطراً.</b> رُصدت عليها ملاحظات في {orgsWith('rst')} منظمة من {nE}، أبرزها أرصدة راكدة لم تُصرف ({pats.find((p) => p.code === 'R1')?.orgs} منظمة)، وصرف يتجاوز التمويل أو مناقلة بين المقيد والحر دون قرار ({pats.find((p) => p.code === 'R2')?.orgs})، وزكاة محتجزة أو مختلطة المعالجة ({pats.find((p) => p.code === 'R4')?.orgs}). وأخطر صورها أن يقل النقد عن الأموال المقيدة نفسها، أي أن أموال المتبرعين صُرفت فعلاً في غير غرضها.</div>
        <div class="insight"><b>2. الدرجة المرتفعة لا تعني سلامة مالية.</b> من {high.length} تحليلاً منح درجة 90 فأعلى في مؤشر الأداء المالي، رصد {highCrit.length} منها ملاحظة جوهرية واحدة على الأقل، ورصد {highLiq.length} منها ضعف سيولة أو عجزاً أو نقداً لا يغطي المقيد. والسبب أن بعض محاور المؤشر تأخذ الدرجة الكاملة عند غياب البيانات، كمصروفات جمع الأموال غير المفصح عنها ({pats.find((p) => p.code === 'X3')?.orgs} منظمة). وبمطابقة الملاحظات مع إطار التقييم المعتمد يتبين أن {outShare}% منها تقع خارج معادلة الدرجة أصلاً (<a href={withBase('framework/')}>التفاصيل</a>). وتُقرأ الدرجات هنا بحذر، إذ نبّه د. علي الفوزان في المحاضرات إلى أن الدرجة التي تحسبها أداة التحليل ليست دقيقة.</div>
        <div class="insight"><b>3. السجلات المحاسبية أضعف من القوائم المدققة.</b> رُصدت ملاحظات على ميزان المراجعة ودليل الحسابات في {orgsWith('tb')} منظمة: فروق بين الميزان والقوائم ({pats.find((p) => p.code === 'T1')?.orgs} منظمة)، وموازين قبل الإقفال أو غير متوازنة أو غير متاحة ({pats.find((p) => p.code === 'T3')?.orgs})، ومخالفات للدليل الموحد ({pats.find((p) => p.code === 'T2')?.orgs}). الرأي النظيف للمراجع لا يعني أن الدفاتر الداخلية تطابق ما نُشر.</div>
        <div class="insight"><b>4. أصول وقفية واستثمارية كبيرة بعائد ضئيل.</b> رُصدت ملاحظات على الأوقاف والأصول في {orgsWith('waqf')} منظمة: عقارات وأراضٍ بلا عائد أو بعائد أقل بكثير من المرجع 7.5% ({pats.find((p) => p.code === 'W1')?.orgs} منظمة)، وخلل في تصنيف الأوقاف أو فصلها عن الأموال الحرة ({pats.find((p) => p.code === 'W2')?.orgs})، ومشروعات متوقفة بالملايين ({pats.find((p) => p.code === 'W3')?.orgs}).</div>
        <div class="insight"><b>5. إيرادات مركّزة وقليلة المرونة.</b> رُصدت ملاحظات على الإيرادات في {orgsWith('rev')} منظمة: تركز في مصادر قليلة كمنصة إحسان أو منحة حكومية أو موسم واحد ({pats.find((p) => p.code === 'V1')?.orgs} منظمة)، وإيراد غير مقيد ومتكرر دون 30% ({pats.find((p) => p.code === 'V2')?.orgs})، وتوقف مصدر رئيسي دون بديل ({pats.find((p) => p.code === 'V3')?.orgs}).</div>
        <div class="insight"><b>6. سيولة حرة رقيقة رغم نقد ظاهر.</b> رُصدت ملاحظات على السيولة في {orgsWith('liq')} منظمة، أبرزها نقد حر يقل بعد طرح المقيد والالتزامات عن 3 أشهر أو يصبح سالباً ({pats.find((p) => p.code === 'L1')?.orgs} منظمة)، وقروض ومستحقات بلا جدول ({pats.find((p) => p.code === 'L3')?.orgs}). وفي المقابل احتفظت منظمات أخرى بملايين في حسابات جارية بلا عائد ({pats.find((p) => p.code === 'L2')?.orgs}).</div>
      </section>

      <section class="rsec" id="tiers">
        <h2><span class="n">5</span> المشترك والخاص</h2>
        <p>صُنفت الأنماط بحسب انتشارها: <b>{common.length}</b> نمطاً {TIER.common}، و<b>{recurring.length}</b> {TIER.recurring}، و<b>{specific.length}</b> {TIER.specific}. المشترك يعالَج بإرشادات عامة للقطاع، والخاص يعالَج مع المنظمة المعنية.</p>
        <h3>أنماط مشتركة</h3>
        <ul>{common.map((p) => <li><a href={withBase(`patterns/${p.code}/`)}>{p.name}</a> — {p.orgs} منظمة</li>)}</ul>
        <h3>ملاحظات خاصة بارزة</h3>
        <p class="note">ملاحظات لم تتكرر بالصورة نفسها لكنها كبيرة الأثر وتستحق المتابعة مع المنظمة مباشرة:</p>
        <ul class="notes">
          {standouts.map((n) => (
            <li><span class={`sev ${n.sev}`}>{SEV[n.sev].label}</span>
              <div><div class="t">{n.t}</div><div class="meta"><a href={withBase(`orgs/${idOf(byFile[n.a])}/`)}>{byFile[n.a].org}</a></div></div></li>
          ))}
        </ul>
      </section>

      <section class="rsec" id="recs">
        <h2><span class="n">6</span> التوصيات العامة والأولويات</h2>
        <p>توصية عامة لكل نمط ظهر في 5 منظمات فأكثر، مرتبة بحسب الأولوية الزمنية. الرقم بجانب كل توصية هو عدد المنظمات التي تخصها.</p>
        {recGroups.map((g) => (
          <>
            <h3><span class={`pri ${g.k}`}>{g.label}</span> <span class="note">{g.list.length} توصية</span></h3>
            <ul class="notes">
              {g.list.map((p) => (
                <li><span class="orgn"><b>{p.orgs}</b>منظمة</span>
                  <div><div class="t"><b>{p.name}:</b> {p.rec}</div><div class="meta"><a href={withBase(`patterns/${p.code}/`)}>الملاحظات المرتبطة ({p.n})</a></div></div></li>
              ))}
            </ul>
          </>
        ))}
      </section>

      <section class="rsec" id="quality">
        <h2><span class="n">7</span> ملاحظة على جودة التحليلات</h2>
        <p>حللت ثلاث منظمات أكثر من مرة ، والمقارنة بين تحليلاتها تكشف أن النتيجة تتأثر بالمحلل وبالبيانات المتاحة له:</p>
        {dupes.map((d) => (
          <>
            <h3>{d.label}</h3>
            <div class="cmpare">
              {d.files.map((f, fi) => { const a = byFile[f]; const l = notesOf(f); const s = sevCounts(l); return (
                <div><b>{['التحليل الأول', 'التحليل الثاني', 'التحليل الثالث'][fi]}</b>
                  <div class="big">{typeof a.m.score === 'number' ? fmt(a.m.score) : '—'}</div><div class="note">درجة المؤشر</div>
                  <div class="note">{l.length} ملاحظة · {s.c} جوهرية</div></div>
              ); })}
            </div>
          </>
        ))}
        <p>ومن أسباب التباين: تصنيف بعض المحللين للخطورة وترك آخرين له، واختلاف معالجة الإهلاك وتوزيع المصروفات عند احتساب الدرجة، وتوفر ميزان المراجعة لبعضهم دون غيرهم. <b>لذلك تُقرأ أعداد الملاحظات مؤشراً على الأنماط لا حكماً نهائياً على كل منظمة</b>، ويُستحسن توحيد قالب الملخص ومنهجية الدرجة في الدفعات القادمة.</p>
      </section>

      <section class="rsec" id="map">
        <h2><span class="n">8</span> خريطة الملاحظات</h2>
        <p class="note">عدد الملاحظات السلبية لكل تحليل في كل محور؛ كلما اشتد اللون زاد العدد. اضغط الاسم لفتح ملخص المنظمة.</p>
        <div class="tablewrap" style="padding:10px">
          <div class="heat" role="table" aria-label="عدد الملاحظات لكل تحليل ومحور">
            <div class="row hd" role="row"><span class="name" role="columnheader">المنظمة</span>{CATS.map((c) => <span role="columnheader" title={c.name}>{CAT_SHORT[c.code]}</span>)}<span role="columnheader">المجموع</span></div>
            {heat.map((h) => (
              <div class="row" role="row">
                <span class="name" role="cell"><a href={withBase(`orgs/${idOf(h.a)}/`)} title={h.a.field || h.a.org}>{h.a.org}</a></span>
                {h.cells.map((v) => <span role="cell" class:list={['cell', !v && 'z']} style={`--v:${Math.round((v / heatMax) * 70) + (v ? 8 : 0)}`}>{v}</span>)}
                <span class="tot" role="cell">{h.tot}</span>
              </div>
            ))}
          </div>
        </div>
      </section>
    </div>
    <aside class="side">
      <div class="panel">
        <b style="font-family:var(--f-display)">أقسام التقرير</b>
        <ul class="toc2" style="margin-top:8px">{toc.map(([id, l]) => <li><a href={`#${id}`}>{l}</a></li>)}</ul>
        <p style="margin:12px 0 0"><a class="btn" href={withBase('data/notes.csv')} download="ملاحظات-التحليل-المالي.csv">تنزيل الملاحظات CSV</a></p>
      </div>
    </aside>
  </div>
</Base>
